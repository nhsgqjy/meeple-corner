{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:pages",
  "outputDirectory": "pages-dist",
  "build": {
    "env": {
      "VITE_API_BASE": "/",
      "PAGES_BASE": "/"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://meeple-corner-api.812097204.workers.dev/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
